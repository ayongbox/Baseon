<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-bom</artifactId>
    <packaging>pom</packaging>

    <name>baseon-bom</name>
    <description>脚手架统一版本管控入口：业务工程 import 本 BOM 后，全工程禁止手写版本号</description>

    <!--
        第三方版本（SpringBoot / SpringCloud / Nacos / MyBatis-Plus 等）由父 POM 的
        dependencyManagement 统一 import，此处通过继承自动向上传递，无需重复声明。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- ========== 基础内核 ========== -->
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- ========== 测试基座（scope=test 使用） ========== -->
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-test-base-core</artifactId>
                <version>${revision}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-test-base-integration</artifactId>
                <version>${revision}</version>
                <scope>test</scope>
            </dependency>

            <!-- ========== Starter 层 ========== -->
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 新增 Starter 时在此追加，与仓库模块同步维护 -->
        </dependencies>
    </dependencyManagement>
</project>
