<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-starter-data-scope</artifactId>
    <packaging>jar</packaging>

    <name>baseon-starter-data-scope</name>
    <description>行级数据权限：@DataScope 注解 + JSqlParser AST 行级 SQL 过滤；字段级脱敏</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-core</artifactId>
        </dependency>

        <!-- 数据权限拦截器装配在 starter-mybatis-plus 的 MybatisPlusInterceptor 链上 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-mybatis-plus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 字段级序列化过滤用 Jackson；provided 表明：仅当业务侧引入 web starter 时才生效 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 集成测试：H2 内存库 + MyBatis-Plus 端到端验证 SQL 改写链路 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
