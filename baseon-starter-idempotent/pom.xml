<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-starter-idempotent</artifactId>
    <packaging>jar</packaging>

    <name>baseon-starter-idempotent</name>
    <description>幂等控制：@Idempotent 切面 + Redis 原子占位，防重复提交</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-core</artifactId>
        </dependency>

        <!-- 原子占位 setIfAbsent 与 key 规范校验 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-redis</artifactId>
        </dependency>

        <!-- RequestContextHolder 读取幂等令牌请求头 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
