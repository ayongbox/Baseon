<?xml version="1.0" encoding="UTF-8"?>
<!--
  Baseon 统一日志格式。

  生效方式：本文件位于 starter-trace 的 classpath 根，业务未提供自己的
  logback-spring.xml 时由 Spring Boot 自动加载；业务在 resources 下放置
  同名文件即可整体覆盖（业务 classes 目录优先于依赖 jar）。

  自定义时建议保留 %X{traceId:-} 占位，否则异步/全链路日志会失去关联键。

  输出格式：
    - 默认（非 prod profile）：文本格式，控制台人读友好；
    - prod profile：JSON 格式（需业务引入 logstash-logback-encoder，optional），
      便于观测云/ELK/Loki 等采集端直接字段化解析。未引入该依赖时 JSON appender
      因类缺失被 logback 自动忽略，prod 下回退到文本格式。
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="app" source="spring.application.name" defaultValue="app"/>

    <!-- 覆盖 Spring Boot 默认 pattern：在线程名后注入 traceId，方便 grep 全链路 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([${app}]){magenta} %clr([%15.15t]){faint} %clr([%X{traceId:-}]){yellow} %clr(%-40.40logger{39}){cyan} : %m%n%wEx"/>

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 非 prod：文本控制台 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- prod：JSON 控制台（logstash-logback-encoder 在场时生效） -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 自定义字段：与文本格式对齐，traceId 取 MDC，值与全链路一致 -->
                <customFields>{"app":"${app}"}</customFields>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <!-- 时间戳用 ISO8601，便于后端解析 -->
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
