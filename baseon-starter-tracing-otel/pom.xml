<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-starter-tracing-otel</artifactId>
    <packaging>jar</packaging>

    <name>baseon-starter-tracing-otel</name>
    <description>分布式追踪 OpenTelemetry 接入：micrometer-tracing OTel 桥接、OTLP 上报、本地日志导出档；与 starter-trace 协同统一 traceId</description>

    <!--
        版本说明：micrometer-tracing / opentelemetry 全家版本由父 POM import 的
        spring-boot-dependencies 统一管理，此处禁止手写版本号。
    -->
    <dependencies>
        <!-- 与 starter-trace 协同：Tracer 在场时 TraceIdFilter 复用全链路 traceId -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-trace</artifactId>
        </dependency>

        <!-- micrometer-observation 入口（web 观测过滤器、AOP 观测均依赖它） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Tracing 的 OTel 桥接：Tracer/Span 门面落到 OTel SDK -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!-- 生产上报通道：OTLP（collector 地址走 management.otlp.tracing.endpoint） -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- 本地开发档载体：LoggingSpanExporter，仅 log-exporter-enabled=true 时使用 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-logging</artifactId>
        </dependency>

        <!-- Feign 观测能力包：spring-cloud-openfeign 检测到它后自动创建 client span 并注入
             W3C traceparent，否则下游服务会另起 trace 导致链路断裂。纯能力库不含 web 栈，
             不用 Feign 的服务引入后自动不生效。版本由 spring-cloud BOM 经 feign-bom 管理 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-micrometer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
