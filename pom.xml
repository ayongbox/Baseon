<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ayongbox</groupId>
    <artifactId>baseon-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>baseon-parent</name>
    <description>通用 SpringCloud 企业微服务脚手架 · 根工程</description>

    <modules>
        <module>baseon-bom</module>
        <module>baseon-core</module>
        <module>baseon-starter-web</module>
        <module>baseon-starter-trace</module>
        <module>baseon-starter-cloud-nacos</module>
        <module>baseon-starter-cloud-feign</module>
        <module>baseon-starter-loadbalance</module>
        <module>baseon-starter-datasource</module>
        <module>baseon-starter-mybatis-plus</module>
        <module>baseon-starter-redis</module>
        <module>baseon-starter-cache</module>
        <module>baseon-starter-tenant</module>
        <module>baseon-starter-auth</module>
        <module>baseon-starter-xss</module>
        <module>baseon-starter-idempotent</module>
        <module>baseon-starter-sentinel</module>
        <module>baseon-starter-resilience</module>
        <module>baseon-starter-excel</module>
        <module>baseon-starter-swagger</module>
        <module>baseon-starter-log</module>
        <module>baseon-starter-debug-tools</module>
        <module>samples/demo-service</module>
        <module>samples/demo-service-b</module>
    </modules>

    <properties>
        <!-- 脚手架整体发行版版本，所有子模块共享，禁止子模块单独声明 version -->
        <revision>1.0.0-SNAPSHOT</revision>

        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.2.12</spring-boot.version>
        <spring-cloud.version>2023.0.5</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.4</spring-cloud-alibaba.version>
        <!-- 适配 Boot 3 的 MP 坐标为 mybatis-plus-spring-boot3-starter，版本线独立演进 -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <caffeine.version>3.1.8</caffeine.version>
        <mysql-connector.version>8.4.0</mysql-connector.version>
        <!-- 5 期新增：JWT 与熔断降级（sentinel 由 SCA BOM 管理，无需在此锁定） -->
        <jjwt.version>0.12.6</jjwt.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- 6 期新增：FastExcel（EasyExcel 停更后的社区续作，Apache 2.0）与 springdoc OpenAPI -->
        <fastexcel.version>1.2.0</fastexcel.version>
        <springdoc.version>2.5.0</springdoc.version>

        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <archunit.version>1.2.1</archunit.version>
    </properties>

    <!-- 内部模块统一继承第三方版本，业务工程则通过 baseon-bom 获得同样的版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- SCA 2023.0.3.x 适配 Boot 3.2.x / Cloud 2023.0.x，提供 Nacos 注册发现与配置中心 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                内部构件版本：父 POM 服务脚手架自身构建 + demo，
                baseon-bom 服务外部业务工程，两处需要同步维护。
                （不能由父 POM import baseon-bom：同一 reactor 内的 BOM 在干净构建时尚未安装）
            -->
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-trace</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-cloud-nacos</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-cloud-feign</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-loadbalance</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-datasource</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-mybatis-plus</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-tenant</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-auth</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-xss</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-idempotent</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-sentinel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-resilience</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-excel</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-swagger</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-log</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ayongbox</groupId>
                <artifactId>baseon-starter-debug-tools</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- 4 期新增第三方：MP 适配 Boot3 坐标独立于旧版 mybatis-plus-boot-starter -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
                MP 3.5.9 起，分页/租户等依赖 jsqlparser 的内置拦截器拆分为独立构件，
                starter 不再传递引入，S-09 必须显式声明（jsqlparser 5.x 线）
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <!-- Boot BOM 管理的 mysql-connector-j 版本跟随 Boot 发布节奏，显式锁定避免被动升级 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <!-- 5 期新增第三方：jjwt 三件套（api 编译期，impl/jackson 运行期） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <!-- resilience4j 的 Boot3 装配入口，注解式熔断/舱壁 -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- 6 期新增第三方：FastExcel 注解式流式读写，poi-ooxml 由其传递引入 -->
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>${fastexcel.version}</version>
            </dependency>
            <!-- springdoc OpenAPI3 + Swagger UI（webmvc 线；webflux 网关场景业务另引 webflux 版） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!--
                fastexcel(2.16.1) 与 feign-form-spring(2.11.0) 传递的 commons-io 版本分歧，
                锁定高版本收敛；commons-io 向后兼容性好，升级对 feign-form-spring 无影响
            -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.16.1</version>
            </dependency>

            <!-- 构建期工具，仅 test scope 使用 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!-- 保留方法参数名，MapStruct / Feign 依赖该信息 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <!--
                    导入的 BOM 只传递 dependencyManagement，不传递 pluginManagement，
                    因此 Boot 插件版本必须在父 POM 显式锁定，否则 Maven 会解析到最新里程碑版本。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Maven 默认绑定的 surefire 版本过旧，不支持 JUnit 5，必须显式锁定 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 展开 ${revision}，解决发布后 POM 变量无法解析的问题 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-env</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.8.6,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 发布前校验：mvn verify -Prelease，禁止任何 SNAPSHOT 依赖进入制品 -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-release</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseDeps>
                                            <message>发布构建禁止依赖 SNAPSHOT 版本</message>
                                        </requireReleaseDeps>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
