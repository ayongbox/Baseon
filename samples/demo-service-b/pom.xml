<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-demo-service-b</artifactId>
    <packaging>jar</packaging>

    <name>baseon-demo-service-b</name>
    <description>3 期验证工程：被 demo-service 通过 Feign 调用的下游服务，不对外发布</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cloud-nacos</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
