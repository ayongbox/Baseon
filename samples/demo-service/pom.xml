<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-demo-service</artifactId>
    <packaging>jar</packaging>

    <name>baseon-demo-service</name>
    <description>0 期验证工程：用于验证 BOM 版本管控与 reactor 构建链路，不对外发布</description>

    <dependencies>
        <!-- 1 期起由 starter-web 统一提供 Web 能力，baseon-core 由其传递引入 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-trace</artifactId>
        </dependency>
        <!-- 3 期：注册发现 + Feign 透传 + 灰度路由 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cloud-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cloud-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-loadbalance</artifactId>
        </dependency>
        <!-- 4 期：动态数据源 + MP + Redis + 两级缓存 + 多租户 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-mybatis-plus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-tenant</artifactId>
        </dependency>
        <!-- 5 期：鉴权 + XSS + 限流 + 韧性 + 幂等 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-xss</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-idempotent</artifactId>
        </dependency>
        <!-- 6 期：Excel + Swagger + 操作审计 + 调试工具 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-log</artifactId>
        </dependency>
        <!-- 7.5 期：OTel 分布式追踪接入，与 starter-trace 协同统一 traceId -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-tracing-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-debug-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
