<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ayongbox</groupId>
        <artifactId>baseon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>baseon-demo-service</artifactId>
    <packaging>jar</packaging>

    <name>baseon-demo-service</name>
    <description>0 期验证工程：用于验证 BOM 版本管控与 reactor 构建链路，不对外发布</description>

    <dependencies>
        <!-- 1 期起由 starter-web 统一提供 Web 能力，baseon-core 由其传递引入 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-trace</artifactId>
        </dependency>
        <!-- 3 期：注册发现 + Feign 透传 + 灰度路由 -->
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cloud-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-cloud-feign</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ayongbox</groupId>
            <artifactId>baseon-starter-loadbalance</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
